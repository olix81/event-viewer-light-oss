# MQTT connection defaults
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_TOPIC=public/test/topic
MQTT_KEEPALIVE=10
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_CLIENT_ID=

# Optional viewer tuning
EVENT_BUFFER_SIZE=512
# HTTP_HOST=localhost
PORT=5000

# SQLite persistence
EVENT_DB_PATH=viewer-events.db
EVENT_DB_ENABLED=1
EVENT_DB_MAX_EVENTS=5000
EVENT_DB_PURGE_BATCH=1000
# SSE replay tuning
SSE_CACHE_LIMIT=1024
# Logging
LOG_LEVEL=INFO
